#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
export PYTHONHOME="$ROOT/python"
export PYTHONPATH="$PYTHONHOME/lib/python3.12/site-packages"
XDG_CONFIG_HOME=$(mktemp -d "${TMPDIR:-/tmp}/vapormint-vs.XXXXXXXX")
export XDG_CONFIG_HOME
trap 'rm -rf "$XDG_CONFIG_HOME"' EXIT HUP INT TERM
# ponytail: standalone python is statically linked, so `vapoursynth config` can't find libpython; write the entry ourselves
VS="$PYTHONPATH/vapoursynth"
mkdir -p "$XDG_CONFIG_HOME/vapoursynth"
printf '"%s" = ["%s","%s","%s"]\n' "$VS/libvsscript.so" "$PYTHONHOME/bin/python3" "$PYTHONHOME/lib/libpython3.12.so.1.0" "$(stat -c %Y "$PYTHONHOME/bin/python3")" > "$XDG_CONFIG_HOME/vapoursynth/vapoursynth.toml"
"$VS/vspipe" "$@"
